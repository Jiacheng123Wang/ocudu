+constant uint mmse_max_filter_len  = 31;
+constant uint mmse_max_dmrs_symb   = 4;
+constant uint mmse_max_layers      = 4;
+constant uint mmse_max_cdm         = 2;
+constant uint mmse_max_slot_symb   = 14;
